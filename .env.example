# --- Обязательные ---
NODE_ENV=production
# Строка подключения к PostgreSQL
DATABASE_URL=postgres://gasmeter:CHANGE_ME@db:5432/gasmeter
# Пароль БД (используется docker compose; должен совпадать с паролем в DATABASE_URL)
DB_PASSWORD=CHANGE_ME
# Секрет для подписи (не менее 32 случайных символов): openssl rand -base64 48
APP_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
# Первичный администратор (создаётся при первом запуске; при первом входе пароль нужно сменить)
ADMIN_LOGIN=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_Temp#2026

# --- Сеть ---
PORT=3000
# Адрес обратного прокси (nginx). При запуске через docker compose — сеть Docker 172.16.0.0/12.
# Неверное значение → все покупатели «на одном IP», и лимит по IP заблокирует проверку для всех.
TRUST_PROXY=172.16.0.0/12
# Cookie только по HTTPS (в production — true)
COOKIE_SECURE=true

# --- Заказы ---
# Срок брони неоплаченного заказа, минут (2 часа). После него заказ отменяется, ТУ освобождается.
ORDER_TTL_MIN=120

# --- Политика паролей ---
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_AGE_DAYS=90

# --- Лимиты по IP-адресу (неудачных попыток за 60 минут) ---
CHECK_IP_MAX_FAILS=30
LOGIN_IP_MAX_FAILS=30

# --- Открытые вопросы ТЗ (раздел 12) ---
# false — запретить покупку по ТУ юридических лиц (БИН)
ALLOW_LEGAL_ENTITIES=true
# Максимальный расход газа по ТУ для покупки бытового счётчика (пусто — без ограничения)
MAX_GAS_FLOW=

# --- Интеграция с кассой (пусто — выключена, оплату подтверждает продавец) ---
POS_API_KEY=
